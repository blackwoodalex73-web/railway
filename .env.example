# GitHub fine-grained personal access token.
# Required: repository access to the selected repository, Contents: Read and write.
# Add Workflows: Read and write only if you need to upload files under .github/workflows.
GITHUB_TOKEN=github_pat_REPLACE_ME

# GitHub account and target repository
GITHUB_OWNER=blackwoodalex73-web
GITHUB_REPO=managerstage
GITHUB_BRANCH=main

# Generate a long random value. This is the secret Claude will send as
# Authorization: Bearer <MCP_ACCESS_KEY>
MCP_ACCESS_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

# Railway provides PORT automatically.
PORT=3000